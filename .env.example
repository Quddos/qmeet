# Copy to .env.local for development. Never commit real values. Never prefix server secrets with NEXT_PUBLIC_.

# Public application URL (canonical, PWA, auth redirects)
NEXT_PUBLIC_APP_URL=https://qmeet.diaspafra.org

# Supabase (public anon key is safe for the browser; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit self-hosted media server (wss://...). Required for meetings.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Redis for rate limiting and webhook idempotency (optional until deployed)
REDIS_URL=

# Secrets, at least 32 characters each. Generate with: openssl rand -base64 48
SESSION_SECRET=
STUDENT_PIN_PEPPER=

# Recording storage (S3-compatible, private bucket). Optional until recording is enabled.
RECORDING_STORAGE_ENDPOINT=
RECORDING_STORAGE_BUCKET=
RECORDING_STORAGE_ACCESS_KEY=
RECORDING_STORAGE_SECRET_KEY=
