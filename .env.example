# --- Supabase (database + realtime). Free tier is enough. ---
# Project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=
# "anon" public key. Safe to expose to browsers (used for realtime only).
SUPABASE_ANON_KEY=
# "service_role" secret key. SERVER ONLY. Never prefix with NEXT_PUBLIC or send to browsers.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend, free tier). Needed only for "Email results". ---
RESEND_API_KEY=
# Must be a verified sender in Resend. The default works for testing only.
RESEND_FROM=QMeet <onboarding@resend.dev>

# --- Optional TURN server for users behind strict firewalls ---
# JSON array, e.g. [{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
ICE_SERVERS=
