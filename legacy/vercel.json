{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/m/:code", "destination": "/room.html?code=:code" },
    { "source": "/q/:id", "destination": "/quiz.html?id=:id" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), display-capture=(self)" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
